    "## 12. Did each change actually help?\n",
    "\n",
    "Every comparison below is **paired by seed** where seeds overlap, which is far more\n",
    "powerful than comparing group means \u2014 it removes the initialisation variance that\n",
    "swamped the earlier one-step sweeps (\u00b10.11\u20130.26 AQL between seeds at a fixed config)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def effect(a, b, question, metric=\"AQL\"):\n",
    "    if R.empty: return\n",
    "    A, B = R[R.tag == a], R[R.tag == b]\n",
    "    if A.empty or B.empty:\n",
    "        print(f\"{question}\\n   (need both {a} and {b})\\n\"); return\n",
    "    ka = set(A.seed) & set(B.seed)\n",
    "    print(question)\n",
    "    if ka:\n",
    "        d = [float(B[B.seed==s][metric].iloc[0] - A[A.seed==s][metric].iloc[0])\n",
    "             for s in sorted(ka)]\n",
    "        verdict = (\"HELPS\" if np.mean(d) < 0 else \"HURTS\")\n",
    "        print(f\"   {b} vs {a}: paired on seeds {sorted(ka)}  \"\n",
    "              f\"deltas {[round(x,3) for x in d]}\")\n",
    "        print(f\"   mean {np.mean(d):+.3f} {metric}  ->  {verdict} \"\n",
    "              f\"({sum(x<0 for x in d)}/{len(d)} seeds better)\")\n",
    "    else:\n",
    "        print(f\"   {a} {A[metric].mean():.3f}   {b} {B[metric].mean():.3f}   \"\n",
    "              f\"(no shared seeds - unpaired)\")\n",
    "    print()\n",
    "\n",
    "# --- protocol-matched to Yu et al. Table 2. These are the citable comparisons; the\n",
    "#     `static` ones below train to 2024-09 and then predict December 2025, which no\n",
    "#     published protocol does.\n",
    "effect(\"mrinn_expanding\", \"gru_expanding\",\n",
    "       \"0a. PAPER PROTOCOL: does the recurrent encoder beat MRINN's Dense encoder?\")\n",
    "effect(\"gru_expanding\", \"gru_rolling\",\n",
    "       \"0b. Expanding (paper) vs rolling 12-month: does dropping 2022 actually pay?\")\n",
    "effect(\"gru_static\", \"gru_expanding\",\n",
    "       \"0c. How much of `static` being bad was just STALENESS, not the window length?\")\n",
    "\n",
    "# --- the day-ahead outage: delete the broken feature, or train the fallback?\n",
    "effect(\"gru_rolling\", \"gru_roll_noknown\",\n",
    "       \"0d. Does DELETING the day-ahead input beat keeping it?\")\n",
    "effect(\"gru_rolling\", \"gru_roll_dadrop\",\n",
    "       \"0e. Does DA-dropout training (p=0.2) beat keeping it untreated?\")\n",
    "effect(\"gru_roll_noknown\", \"gru_roll_dadrop\",\n",
    "       \"0f. Train the fallback vs delete the feature -- which wins?\")\n",
    "\n",
    "# --- the paper's scaling law (Sec. 5.2.3): long inputs should pay at long horizons\n",
    "effect(\"gru_rolling\", \"gru_roll_T96\",\n",
    "       \"0g. T=96 (1440 min) vs T=32 (480 min) -- the paper predicts long wins here.\")\n",
    "\n",
    "effect(\"mrinn_static\", \"gru_static\",\n",
    "       \"1. Does the recurrent encoder beat MRINN's Dense encoder at 24 h?\")\n",
    "effect(\"gru_static\", \"gru_rolling\",\n",
    "       \"2. Does a ROLLING 12-month training window beat all-history training?\")\n",
    "effect(\"mrinn_static\", \"mrinn_rolling\",\n",
    "       \"2b. ...and does it help MRINN too? (if yes, the gain is about DATA, not encoder)\")\n",
    "effect(\"gru_no_hembed\", \"gru_static\",\n",
    "       \"3. Is the horizon embedding load-bearing?\")\n",
    "effect(\"gru_no_known\", \"gru_static\",\n",
    "       \"4. What are the day-ahead price and calendar worth at 24 h?\")\n",
    "effect(\"gru_static\", \"lstm_static\",\n",
    "       \"5. Does the cell type (LSTM vs GRU) matter here?\")\n",
    "effect(\"gru_static\", \"gru_H10\",\n",
    "       \"6. Does adding neurons help? (H=8 -> H=10, still under 8,900 params)\")\n",
    "\n",
    "# --- the horizon-blindness check, stated as a number ---\n",
    "if not R.empty and {\"gru_static\",\"gru_no_hembed\"} <= set(R.tag):\n",
    "    a = R[R.tag==\"gru_no_hembed\"].skill_slope.mean()\n",
    "    b = R[R.tag==\"gru_static\"].skill_slope.mean()\n",
    "    print(f\"7. Skill-curve slope (AQL at h=96 minus h=1; should be clearly POSITIVE)\")\n",
    "    print(f\"   without horizon embedding {a:+.3f}      with it {b:+.3f}\")\n",
    "    print(f\"   -> {'the embedding restores horizon sensitivity' if b > a else 'NO horizon sensitivity gained -- investigate'}\")\n",
    "\n",
    "# --- what the multi-horizon model gives up at h=1 ---\n",
    "if not R.empty and {\"gru_static\",\"gru_1step\"} <= set(R.tag):\n",
    "    one = R[R.tag==\"gru_1step\"].AQL.mean()\n",
    "    multi = R[R.tag==\"gru_static\"].AQL_h1.mean()\n",
    "    print(f\"\\n8. Cost of covering a whole day with one model, at h=1:\")\n",
    "    print(f\"   dedicated one-step {one:.3f}   multi-horizon at h=1 {multi:.3f}   \"\n",
    "          f\"({(multi/one-1)*100:+.1f}%)\")\n",
    "    print(\"   Expected: h=1 gets ~1/96 of the gradient. If short-horizon accuracy\")\n",
    "    print(\"   matters operationally, keep the one-step model for h=1.\")\n",
    "\n",
    "\n",
    "# --- the blackout is where every ranking was actually decided ---------------\n",
    "if not R.empty:\n",
    "    print(\"\\n\" + \"=\" * 74)\n",
    "    print(\"Q4 / day-ahead blackout: AQL on DA-covered rows vs DA-dead rows\")\n",
    "    print(\"A model that consumes the day-ahead price and never trained for its absence\")\n",
    "    print(\"scores WORSE on the blackout rows even though Nov-Dec is the calmest\")\n",
    "    print(\"stretch of the year (price std 68.6 against 428.7).\")\n",
    "    print(\"=\" * 74)\n",
    "    t = (R.groupby(\"tag\")[[\"AQL\", \"AQL_cov\", \"AQL_blk\"]].mean()\n",
    "          .assign(penalty=lambda d: d.AQL_blk - d.AQL_cov)\n",
    "          .sort_values(\"penalty\"))\n",
    "    print(t.round(2).to_string())\n",
    "    print(\"\\npenalty <= 0 means the model handled the outage; large positive means it broke.\")\n"
   ]
  },
