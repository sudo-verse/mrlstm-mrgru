    "## 10. The baseline, and whether the model is usable at all\n",
    "\n",
    "Seasonal naive: the price at the same interval yesterday. If the model does not beat\n",
    "this at every horizon, it is not usable \u2014 no amount of architecture is worth anything\n",
    "against a one-line rule."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "sets_b, y_scaler_b, _C = get_fold_data(\"static\", 0, \"gru\", HORIZONS)\n",
    "_, yte_b, ste_b = sets_b[\"test\"]\n",
    "\n",
    "yt_n, yp_n, ok_n = seasonal_naive(yte_b, ste_b, y_scaler_b, QUANTILES)\n",
    "naive_scaled_t = y_scaler_b.transform(yt_n.reshape(-1,1)).reshape(yt_n.shape)\n",
    "naive_scaled_p = np.stack([y_scaler_b.transform(yp_n[:,:,j].reshape(-1,1)).reshape(yp_n.shape[:2])\n",
    "                           for j in range(len(QUANTILES))], -1)\n",
    "NAIVE_H = evaluate_by_horizon(naive_scaled_t, naive_scaled_p, QUANTILES, y_scaler_b)\n",
    "NAIVE   = summarise(NAIVE_H)\n",
    "\n",
    "print(\"seasonal naive (price at this time yesterday)\")\n",
    "print(f\"  AQL {NAIVE['AQL']:7.3f}   MAE {NAIVE['MAE']:6.2f}   RMSE {NAIVE['RMSE']:6.2f}\")\n",
    "print(f\"  AQL h=1 {NAIVE['AQL_h1']:.2f}  ->  h={HORIZONS} {NAIVE['AQL_h96']:.2f}\")\n",
    "print(f\"  evaluated on {len(yt_n):,} rows ({(~ok_n).sum()} dropped: no matching interval \"\n",
    "      f\"24 h earlier)\")"
   ]
  },
